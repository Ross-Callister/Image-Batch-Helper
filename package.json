{
  "name": "image-batch-helper",
  "version": "0.1.0",
  "description": "Batch image utility desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false --tsBuildInfoFile out/typecheck-node.tsbuildinfo -p tsconfig.node.json && tsc --noEmit --pretty false --tsBuildInfoFile out/typecheck-web.tsbuildinfo -p tsconfig.web.json",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.imagebatchhelper",
    "productName": "Image Batch Helper",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
